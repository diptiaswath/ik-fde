# The Meridian Engagement — every knob in one file.
# Copy to .env  (never commit .env — it is git-ignored)
#
#     cp .env.example .env
#     set -a; source .env; set +a
#
# Defaults below are the SELF-HOSTED ones: `make up && make web` and everything works.

# ─────────────────────────────────────────────────────────────────────────────
# 1. WHICH PORTAL — the only line most people change
# ─────────────────────────────────────────────────────────────────────────────
# self-hosted on your laptop (make up && make web):
MERIDIAN_BASE_URL=http://localhost:3100/api/v1
MERIDIAN_CONSOLE_URL=http://localhost:3100
#
# the hosted class instance (nothing to run — always on):
# MERIDIAN_BASE_URL=https://ik-fde-casestudy-bank.vercel.app/api/v1
# MERIDIAN_CONSOLE_URL=https://ik-fde-casestudy-bank.vercel.app
#
# your own EC2 box (see deploy/ec2/EC2_DEPLOY.md):
# MERIDIAN_BASE_URL=http://ec2-1-2-3-4.compute-1.amazonaws.com:3100/api/v1
# MERIDIAN_CONSOLE_URL=http://ec2-1-2-3-4.compute-1.amazonaws.com:3100

# ─────────────────────────────────────────────────────────────────────────────
# 2. ANALYST API KEYS — mint with `make keys`, then paste here
# ─────────────────────────────────────────────────────────────────────────────
# A key IS an analyst seat: it carries that analyst's scope (type_a / type_b) and
# learner_id. Scope is enforced server-side; the model can never widen it.
MERIDIAN_API_KEY=mrdn_replace_me_type_a

# ─────────────────────────────────────────────────────────────────────────────
# 3. DATABASE (only if you self-host)
# ─────────────────────────────────────────────────────────────────────────────
MERIDIAN_DB_URL=postgresql://meridian:meridian@localhost:5432/meridian

# ─────────────────────────────────────────────────────────────────────────────
# 4. AWS BEDROCK — the model. Optional: every lab has a $0 mock path.
# ─────────────────────────────────────────────────────────────────────────────
# Credentials come from your shell or ~/.aws (aws configure) — NOT from this file.
BEDROCK_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
MODEL_FAST=bedrock/converse/us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_SMART=bedrock/converse/us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# Verify access before class:  aws sts get-caller-identity && aws bedrock list-foundation-models --region us-east-1 --query 'length(modelSummaries)'
# On the shared training account the Lab Control Panel's Start/Stop IS the IAM
# switch: stopped ⇒ explicit deny on bedrock:* and bedrock-agentcore:*.
