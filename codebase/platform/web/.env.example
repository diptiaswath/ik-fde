# Meridian Ops Console — environment
#
# Postgres connection string for the Meridian database.
# Local Docker fallback (default if unset):
MERIDIAN_DB_URL=postgresql://meridian:meridian@localhost:5432/meridian

# Hosted Supabase example (use the POOLER / session connection string):
# MERIDIAN_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Notes:
# - SSL is auto-enabled when the host is NOT localhost (Supabase requires it);
#   localhost stays plaintext for local Docker dev. See src/lib/db.ts.
#
# Agent-facing API (see API.md):
# - Auth is API-KEY based, separate from the UI cookie session.
# - Mint keys with: node platform/db/mint-key.mjs --demo
#   (or --email <analyst_email> [--learner <id>] [--label <text>])
# - Keys (mrdn_<32 hex>) map to a seeded analyst seat carrying scope + learner_id;
#   only sha256(key) is stored in meridian.api_keys.
# - Apply platform/db/api.sql once (after schema.sql) to create api_keys,
#   idempotency_keys, and the learner_ticket_seq sequence.
